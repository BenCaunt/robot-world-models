{
  "$defs": {
    "JointMapping": {
      "additionalProperties": false,
      "properties": {
        "animate_in_rerun": {
          "title": "Animate In Rerun",
          "type": "boolean"
        },
        "coverage": {
          "enum": [
            "partial",
            "complete"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "dataset_units": {
          "title": "Dataset Units",
          "type": "string"
        },
        "entries": {
          "additionalProperties": {
            "$ref": "#/$defs/JointTransform"
          },
          "minProperties": 1,
          "title": "Entries",
          "type": "object"
        },
        "out_of_range_policy": {
          "enum": [
            "clamp",
            "reject"
          ],
          "title": "Out Of Range Policy",
          "type": "string"
        },
        "status": {
          "enum": [
            "provisional",
            "validated"
          ],
          "title": "Status",
          "type": "string"
        },
        "unmapped_features": {
          "items": {
            "type": "string"
          },
          "title": "Unmapped Features",
          "type": "array"
        },
        "urdf_units": {
          "title": "Urdf Units",
          "type": "string"
        },
        "validation_required": {
          "items": {
            "type": "string"
          },
          "title": "Validation Required",
          "type": "array"
        }
      },
      "required": [
        "status",
        "coverage",
        "animate_in_rerun",
        "dataset_units",
        "urdf_units",
        "out_of_range_policy",
        "entries",
        "validation_required"
      ],
      "title": "JointMapping",
      "type": "object"
    },
    "JointTransform": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "offset": {
          "title": "Offset",
          "type": "number"
        },
        "scale": {
          "title": "Scale",
          "type": "number"
        },
        "urdf_joint": {
          "title": "Urdf Joint",
          "type": "string"
        }
      },
      "required": [
        "urdf_joint",
        "scale",
        "offset",
        "evidence"
      ],
      "title": "JointTransform",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dataset": {
      "title": "Dataset",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "const": "joint-mapping",
      "title": "Kind",
      "type": "string"
    },
    "known_limitations": {
      "items": {
        "type": "string"
      },
      "title": "Known Limitations",
      "type": "array"
    },
    "mapping": {
      "$ref": "#/$defs/JointMapping"
    },
    "robot": {
      "title": "Robot",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "display_name",
    "dataset",
    "robot",
    "mapping"
  ],
  "title": "JointMappingManifest",
  "type": "object"
}
