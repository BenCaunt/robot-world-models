      "manifest": {
        "dataset": "nashmo-so101",
        "display_name": "nashmo SO-101 features to SO-ARM101 URDF joints",
        "id": "nashmo-so101-to-so-arm101",
        "kind": "joint-mapping",
        "known_limitations": [
          "The five arm-joint transforms follow LeRobot's official old-to-new calibration conversion.",
          "The gripper stays at its URDF default because the SO-101 package says its 0-100 mapping is not reflected in the URDF or MJCF.",
          "A small number of converted shoulder-lift and wrist-flex values exceed current URDF limits and are visibly counted and clamped for rendering."
        ],
        "mapping": {
          "animate_in_rerun": true,
          "coverage": "partial",
          "dataset_units": "legacy LeRobot degrees for arm joints; normalized 0-100 for gripper",
          "entries": {
            "main_elbow_flex": {
              "evidence": [
                "https://huggingface.co/docs/lerobot/main/en/backwardcomp converts elbow_flex as old - 90 degrees.",
                "Rerun UrdfJoint requires revolute values in radians."
              ],
              "offset": -1.5707963267948966,
              "scale": 0.017453292519943295,
              "urdf_joint": "3"
            },
            "main_shoulder_lift": {
              "evidence": [
                "https://huggingface.co/docs/lerobot/main/en/backwardcomp converts shoulder_lift as -(old - 90) degrees.",
                "Rerun UrdfJoint requires revolute values in radians."
              ],
              "offset": 1.5707963267948966,
              "scale": -0.017453292519943295,
              "urdf_joint": "2"
            },
            "main_shoulder_pan": {
              "evidence": [
                "https://huggingface.co/docs/lerobot/main/en/backwardcomp keeps shoulder_pan unchanged in degrees.",
                "Rerun UrdfJoint requires revolute values in radians."
              ],
              "offset": 0.0,
              "scale": 0.017453292519943295,
              "urdf_joint": "1"
            },
            "main_wrist_flex": {
              "evidence": [
                "https://huggingface.co/docs/lerobot/main/en/backwardcomp keeps wrist_flex unchanged in degrees.",
                "Rerun UrdfJoint requires revolute values in radians."
              ],
              "offset": 0.0,
              "scale": 0.017453292519943295,
              "urdf_joint": "4"
            },
            "main_wrist_roll": {
              "evidence": [
                "https://huggingface.co/docs/lerobot/main/en/backwardcomp keeps wrist_roll unchanged in degrees.",
                "Rerun UrdfJoint requires revolute values in radians."
              ],
              "offset": 0.0,
              "scale": 0.017453292519943295,
              "urdf_joint": "5"
            }
          },
          "out_of_range_policy": "clamp",
          "status": "validated",
          "unmapped_features": [
            "main_gripper"
          ],
          "urdf_units": "radians",
          "validation_required": [
            "derive and validate the LeRobot 0-100 gripper command to URDF jaw-angle transform",
            "visually compare several recorded poses with source video"
          ]
        },
        "robot": "so-arm101",
        "schema_version": 1
      },
