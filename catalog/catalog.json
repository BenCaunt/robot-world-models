          "horizon_steps": 1,
          "prediction_target": "next pooled DINOv2 patch tokens, decoded RGB frame, and joint state",
          "purpose": "prove a camera-to-latent-to-rollout pipeline on MPS before scaling it on CUDA"
        },
        "joint_mapping": "nashmo-so101-to-so-arm101",
        "kind": "recipe",
        "known_limitations": [
          "The first visual recipe uses only the laptop camera and five episodes.",
          "DINOv2 is not yet represented in either WarmHub registry; the official upstream artifact is pinned and the gap is recorded in discovery.json.",
          "The 4x4 pooled patch grid and 64x64 learned decoder favor a bounded local proof over visual fidelity.",
          "The predictor is trained one step at a time, so open-loop error is expected to compound.",
          "Rerun animates the five validated arm joints; the unmapped gripper remains at its URDF default.",
          "Remote provisioning remains plan-only until teardown tests pass."
        ],
        "mixture": {
          "datasets": [
            "nashmo-so101"
          ],
          "missing_modality_policy": "reject-required",
          "normalization": "per-feature-training-split for state and action; L2-normalized visual tokens",
          "robot": "so-arm101",
          "sampling": "episode-uniform windows",
          "split": {
            "test_fraction": 0.2,
            "train_fraction": 0.6,
            "unit": "episode",
            "validation_fraction": 0.2
          },
          "type": "homogeneous"
        },
        "modalities": {
          "optional": [],
          "required": [
