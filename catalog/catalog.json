          "hidden_dimension": 512,
          "hidden_layers": 2,
          "implementation": "robot_world_models.models.visual_latent:VisualLatentDynamics",
          "state_dimension": 6,
          "vision": {
            "camera": "observation.images.laptop",
            "context_frames": 3,
